---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/static/Navbar.astro';
import Hero from '../components/static/Hero.astro';
import SkillsExperience from '../components/static/SkillsExperience.astro';
import Footer from '../components/static/Footer.astro';
import AutomationSandbox from '../components/islands/AutomationSandbox';
import ProjectShowcase from '../components/islands/ProjectShowcase';
import SmartContactEstimator from '../components/islands/SmartContactEstimator';
import AiPortfolioAssistant from '../components/islands/AiPortfolioAssistant';
---

<BaseLayout>
  <Navbar />

  <main>
    <Hero />

    <section id="automations" class="section-padding border-t border-[#233554]">
      <div class="container-page">
        <header class="max-w-2xl">
          <p class="font-mono text-sm text-electric-cyan">// automation sandbox</p>
          <h2 class="section-heading mt-2">Test Live Automations</h2>
          <p class="mt-3 text-muted-slate">
            Run simulated pipelines and watch real-time logs, latency, and structured JSON output.
          </p>
        </header>
        <div class="mt-10">
          <AutomationSandbox client:visible />
        </div>
      </div>
    </section>

    <section id="projects" class="section-padding border-t border-[#233554]">
      <div class="container-page">
        <header class="max-w-2xl">
          <p class="font-mono text-sm text-electric-cyan">// featured work</p>
          <h2 class="section-heading mt-2">Projects</h2>
          <p class="mt-3 text-muted-slate">
            AI automation, full-stack apps, and browser tools I've designed and shipped.
          </p>
        </header>
        <div class="mt-10">
          <ProjectShowcase client:visible />
        </div>
      </div>
    </section>

    <SkillsExperience />

    <section id="contact" class="section-padding border-t border-[#233554]">
      <div class="container-page">
        <header class="max-w-2xl">
          <p class="font-mono text-sm text-electric-cyan">// get in touch</p>
          <h2 class="section-heading mt-2">Let's Build Something</h2>
          <p class="mt-3 text-muted-slate">
            Scope your project or role and send me a ready-to-go brief.
          </p>
        </header>
        <div class="mt-10">
          <SmartContactEstimator client:visible />
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <AiPortfolioAssistant client:idle />
</BaseLayout>
