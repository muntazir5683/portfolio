---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/static/Navbar.astro';
import Hero from '../components/static/Hero.astro';
import Services from '../components/static/Services.astro';
import SkillsExperience from '../components/static/SkillsExperience.astro';
import Footer from '../components/static/Footer.astro';
import AutomationSandbox from '../components/islands/AutomationSandbox';
import ProjectShowcase from '../components/islands/ProjectShowcase';
import SmartContactEstimator from '../components/islands/SmartContactEstimator';
import AiPortfolioAssistant from '../components/islands/AiPortfolioAssistant';
---

<BaseLayout>
  <Navbar />

  <main>
    <Hero />

    <Services />

    <section id="projects" class="section-padding border-t border-white/[0.08]">
      <!-- Alias for crawlers / bookmarks that expect #systems (navbar uses #projects) -->
      <div id="systems" class="sr-only" aria-hidden="true">Systems</div>
      <div class="container-page">
        <ProjectShowcase client:visible />
      </div>
    </section>

    <section id="automations" class="studio-canvas studio-canvas-alt section-padding border-t border-white/[0.08]">
      <div class="container-page">
        <header class="max-w-2xl">
          <p class="section-kicker">Live systems</p>
          <h2 class="section-heading mt-2">Mortgage automation pipeline simulator</h2>
          <p class="mt-3 text-muted-slate">
            Run demos of borrower pre-qual, W-2/DTI extraction, and missing-doc follow-up — step logs and sample JSON.
          </p>
        </header>
        <div class="mt-10">
          <AutomationSandbox client:visible />
        </div>
      </div>
    </section>

    <SkillsExperience />

    <section id="contact" class="section-padding border-t border-white/[0.08]">
      <div class="container-page">
        <header class="max-w-2xl">
          <p class="section-kicker">Contact</p>
          <h2 class="section-heading mt-2">Scope custom AI agent development services</h2>
          <p class="mt-3 text-muted-slate">
            Tell me about your lead flow, document intake, and LOS/CRM. I will turn it into a short brief for AI agents for mortgage brokers you can email or copy.
          </p>
        </header>
        <div class="mt-10">
          <SmartContactEstimator client:visible />
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <AiPortfolioAssistant client:idle />
</BaseLayout>
