---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/static/Navbar.astro';
import Hero from '../components/static/Hero.astro';
import SkillsExperience from '../components/static/SkillsExperience.astro';
import Footer from '../components/static/Footer.astro';
import AutomationSandbox from '../components/islands/AutomationSandbox';
import ProjectShowcase from '../components/islands/ProjectShowcase';
import SmartContactEstimator from '../components/islands/SmartContactEstimator';
import AiPortfolioAssistant from '../components/islands/AiPortfolioAssistant';
---

<BaseLayout>
  <Navbar />

  <main>
    <Hero />

    <section id="automations" class="section-padding border-t border-white/[0.08]">
      <div class="container-page">
        <header class="max-w-2xl">
          <p class="section-kicker">Pipelines</p>
          <h2 class="section-heading mt-2">System architecture &amp; pipeline demos</h2>
          <p class="mt-3 text-muted-slate">
            Step through a few pipelines I have built — logs, timing, and sample JSON output.
          </p>
        </header>
        <div class="mt-10">
          <AutomationSandbox client:visible />
        </div>
      </div>
    </section>

    <section id="projects" class="section-padding border-t border-white/[0.08]">
      <div class="container-page">
        <header class="max-w-2xl">
          <p class="section-kicker">Selected work</p>
          <h2 class="section-heading mt-2">Projects</h2>
          <p class="mt-3 text-muted-slate">
            Web apps, scrapers, and browser tools I have designed and shipped.
          </p>
        </header>
        <div class="mt-10">
          <ProjectShowcase client:visible />
        </div>
      </div>
    </section>

    <SkillsExperience />

    <section id="contact" class="section-padding border-t border-white/[0.08]">
      <div class="container-page">
        <header class="max-w-2xl">
          <p class="section-kicker">Contact</p>
          <h2 class="section-heading mt-2">Project inquiry &amp; scope</h2>
          <p class="mt-3 text-muted-slate">
            Tell me what you need. I will turn it into a short brief you can email or copy.
          </p>
        </header>
        <div class="mt-10">
          <SmartContactEstimator client:visible />
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <AiPortfolioAssistant client:idle />
</BaseLayout>
