---
import { ArrowRight, Layers, Zap } from 'lucide-react';
import { profile } from '../../data/portfolioData';
import SocialIcon from './SocialIcon.astro';

const trustStrip = [
  'Full-Stack React & FastAPI',
  'Custom Scrapers & AI Pipelines',
  'Fast Turnaround & Clean Code',
];

const stackBadges = ['Python', 'FastAPI', 'React', 'Astro', 'Scrapers'];
---

<section class="hero studio-canvas relative isolate overflow-hidden">
  <div class="container-page grid min-h-[calc(100svh-4rem)] min-w-0 items-center gap-12 py-20 lg:grid-cols-12 lg:gap-10 lg:py-24">
    <!-- Left: value + CTAs -->
    <div class="min-w-0 lg:col-span-7">
      <p class="font-mono text-sm text-muted-slate">
        {profile.brand.slice(0, -1)}<span class="text-electric-cyan">{profile.brand.slice(-1)}</span>
        <span class="mx-2 text-white/20">·</span>
        {profile.name}
      </p>

      <h1 class="mt-5 max-w-xl text-4xl font-semibold leading-[1.12] tracking-tight text-white sm:text-5xl lg:text-[3.25rem]">
        I build fast web apps &amp; custom automations that save hours of manual work
      </h1>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted-slate sm:text-lg">
        {profile.summary}
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href="#contact" class="btn-primary">
          <Zap size={18} aria-hidden="true" />
          Start a Project
        </a>
        <a href="#automations" class="btn-glass">
          <Layers size={18} aria-hidden="true" />
          Explore Live Systems
          <ArrowRight size={16} aria-hidden="true" />
        </a>
      </div>

      <ul
        class="mt-8 flex flex-col gap-2 border-t border-white/[0.08] pt-6 text-sm text-muted-slate sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-0 sm:gap-y-2"
        aria-label="Focus areas"
      >
        {
          trustStrip.map((item, i) => (
            <li class="flex items-center">
              {i > 0 && <span class="mx-3 hidden text-white/20 sm:inline" aria-hidden="true">•</span>}
              <span>{item}</span>
            </li>
          ))
        }
      </ul>

      <ul class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
        {
          profile.socials.map((social) => (
            <li>
              <a
                href={social.url}
                target={social.id === 'email' ? undefined : '_blank'}
                rel={social.id === 'email' ? undefined : 'noopener noreferrer'}
                class="inline-flex items-center gap-2 text-sm text-muted-slate transition-colors hover:text-white"
                aria-label={`${social.label}${social.handle ? ` (${social.handle})` : ''}`}
              >
                <SocialIcon id={social.id} />
                <span>{social.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Right: engineering snapshot bento -->
    <aside class="min-w-0 lg:col-span-5">
      <div class="card overflow-hidden">
        <div class="window-chrome">
          <span class="window-dot bg-[#ff5f57]/80"></span>
          <span class="window-dot bg-[#febc2e]/80"></span>
          <span class="window-dot bg-[#28c840]/80"></span>
          <span class="ml-2 font-mono text-[11px] text-muted-slate">engineering-snapshot.json</span>
        </div>

        <div class="space-y-5 p-5 sm:p-6">
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="text-xs font-medium tracking-wide text-muted-slate">Availability</p>
              <p class="mt-1 flex items-center gap-2 text-sm text-white">
                <span class="relative flex size-2">
                  <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-status opacity-40"></span>
                  <span class="relative inline-flex size-2 rounded-full bg-emerald-status"></span>
                </span>
                {profile.availability}
              </p>
            </div>
            <span class="tag-mono">{profile.title}</span>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="rounded-lg border border-white/[0.08] bg-navy/50 p-3">
              <p class="font-mono text-[11px] text-muted-slate">Systems</p>
              <p class="mt-1 text-lg font-semibold text-white">5+</p>
              <p class="text-xs text-muted-slate">in production use</p>
            </div>
            <div class="rounded-lg border border-white/[0.08] bg-navy/50 p-3">
              <p class="font-mono text-[11px] text-muted-slate">Delivery</p>
              <p class="mt-1 text-lg font-semibold text-white">E2E</p>
              <p class="text-xs text-muted-slate">scope → deploy</p>
            </div>
          </div>

          <div>
            <p class="mb-2 text-xs font-medium tracking-wide text-muted-slate">Core stack</p>
            <ul class="flex flex-wrap gap-2">
              {
                stackBadges.map((badge) => (
                  <li class="tag-mono !text-electric-cyan">{badge}</li>
                ))
              }
            </ul>
          </div>

          <div class="rounded-lg border border-white/[0.08] bg-navy/40 p-3 font-mono text-[11px] leading-relaxed text-muted-slate">
            <p><span class="text-sky-300">focus</span>: web apps, scrapers, extensions</p>
            <p><span class="text-sky-300">stack</span>: Python / FastAPI / React</p>
            <p><span class="text-sky-300">mode</span>: full-time · freelance</p>
          </div>
        </div>
      </div>
    </aside>
  </div>
</section>
