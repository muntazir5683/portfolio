---
import { ArrowRight, Layers } from 'lucide-react';
import { profile } from '../../data/portfolioData';
import SocialIcon from './SocialIcon.astro';

const [firstRole = ''] = profile.roles;
---

<section class="hero relative isolate overflow-hidden">
  <div class="hero-wash pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-page flex min-h-[calc(100svh-4rem)] min-w-0 flex-col justify-center py-20 sm:py-28">
    <p
      class="inline-flex w-fit items-center gap-2 rounded-md border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs text-muted-slate sm:text-sm"
    >
      <span class="size-1.5 rounded-full bg-emerald-status" aria-hidden="true"></span>
      {profile.availability}
    </p>

    <h1 class="mt-6 max-w-full break-words text-4xl font-semibold leading-[1.1] tracking-tight text-white sm:text-6xl lg:text-7xl">
      {profile.name}
    </h1>

    <p class="mt-4 max-w-2xl text-lg text-muted-slate sm:text-xl">
      {profile.headline}
    </p>

    <p class="mt-3 min-h-6 font-mono text-sm text-muted-slate sm:text-base">
      <span class="text-white/30">›</span>
      <span
        id="role-ticker"
        data-roles={JSON.stringify(profile.roles)}
        class="ml-2 inline-block transition duration-300 ease-out"
      >{firstRole}</span>
    </p>

    <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted-slate sm:text-lg">
      {profile.summary}
    </p>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a href="#automations" class="btn-primary">
        <Layers size={18} aria-hidden="true" />
        Pipeline demos
      </a>
      <a href="#projects" class="btn-outline">
        View projects
        <ArrowRight size={18} aria-hidden="true" />
      </a>
    </div>

    <ul class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
      {
        profile.socials.map((social) => (
          <li>
            <a
              href={social.url}
              target={social.id === 'email' ? undefined : '_blank'}
              rel={social.id === 'email' ? undefined : 'noopener noreferrer'}
              class="inline-flex items-center gap-2 text-sm text-muted-slate transition-colors hover:text-white"
              aria-label={`${social.label}${social.handle ? ` (${social.handle})` : ''}`}
            >
              <SocialIcon id={social.id} />
              <span>{social.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero-wash {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.02), transparent 42%),
      radial-gradient(ellipse 80% 50% at 10% 0%, rgb(56 189 248 / 0.05), transparent 55%);
  }
</style>

<script>
  const el = document.getElementById('role-ticker');
  if (el) {
    const roles: string[] = JSON.parse(el.dataset.roles ?? '[]');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    if (roles.length > 1) {
      setInterval(() => {
        i = (i + 1) % roles.length;
        if (reduceMotion) {
          el.textContent = roles[i] ?? '';
          return;
        }
        el.classList.add('opacity-0');
        setTimeout(() => {
          el.textContent = roles[i] ?? '';
          el.classList.remove('opacity-0');
        }, 220);
      }, 2800);
    }
  }
</script>
