---
import { profile, navLinks } from '../../data/portfolioData';
import SocialIcon from './SocialIcon.astro';

const year = new Date().getFullYear();
---

<!-- Extra bottom padding clears the floating AI assistant FAB on mobile -->
<footer class="border-t border-[#233554] bg-navy pb-24 sm:pb-12">
  <div class="container-page py-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div class="min-w-0">
        <a
          href="#"
          class="font-mono text-xl font-bold tracking-tight text-white"
          aria-label={`${profile.name} — back to top`}
          >{profile.brand.slice(0, -1)}<span class="text-electric-cyan"
            >{profile.brand.slice(-1)}</span
          ></a
        >
        <p class="mt-2 max-w-xs text-sm text-muted-slate">{profile.headline}</p>
      </div>

      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-muted-slate transition-colors hover:text-electric-cyan"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="flex flex-wrap items-center gap-3">
        {
          profile.socials.map((social) => (
            <li>
              <a
                href={social.url}
                target={social.id === 'email' ? undefined : '_blank'}
                rel={social.id === 'email' ? undefined : 'noopener noreferrer'}
                class="inline-flex size-10 items-center justify-center rounded-lg border border-[#233554] text-muted-slate transition-colors hover:border-electric-cyan hover:text-electric-cyan"
                aria-label={`${social.label}${social.handle ? ` (${social.handle})` : ''}`}
              >
                <SocialIcon id={social.id} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-[#233554] pt-6 text-xs text-muted-slate sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="min-w-0 break-words">
        &copy; <span id="footer-year">{year}</span>
        {profile.name}. All rights reserved.
      </p>
      <p class="tag-mono w-fit max-w-full">Built with Astro, React &amp; Tailwind CSS</p>
    </div>
  </div>
</footer>

<script>
  // Keeps the year current even if the static build is older than the visit.
  const yearEl = document.getElementById('footer-year');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>
